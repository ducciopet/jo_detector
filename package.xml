<?xml version="1.0"?>
<package format="3">
  <name>onboard_detector</name>
  <version>1.0.0</version>
  <description>The onboard detector package for dynamic object detection.</description>

  <maintainer email="zhefanx@andrew.cmu.edu">Zhefan Xu</maintainer>
  <license>MIT</license>

  <!-- Build system -->
  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- Core dependencies -->
  <depend>rclcpp</depend>
  <depend>std_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>visualization_msgs</depend>
  <depend>cv_bridge</depend>
  <depend>message_filters</depend>
  <depend>image_transport</depend>
  <depend>vision_msgs</depend>
  <depend>pcl_conversions</depend>
  <depend>tf2</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_geometry_msgs</depend>
  <depend>jo_msgs</depend>

  <!-- PCL -->
  <depend>pcl_ros</depend>

  <!-- compressed/compressedDepth image_transport plugins: not linked
       against directly (image_transport loads them via pluginlib at
       runtime), but required for the "compressed"/"compressedDepth"
       transport hints used throughout this package to actually resolve.
       Already installed via image-transport-plugins in docker/Dockerfile. -->
  <exec_depend>compressed_image_transport</exec_depend>
  <exec_depend>compressed_depth_image_transport</exec_depend>

  <!-- GICP-based depth<->lidar registration for calibration_icp_node.
       Provided by the same gtsam/gtsam_points install the glim submodule
       requires (see docker/Dockerfile); no rosdep key here, matching
       glim/package.xml which also resolves it outside rosdep. -->
  <depend>eigen</depend>

  <!-- Service generation -->
  <build_depend>rosidl_default_generators</build_depend>
  <exec_depend>rosidl_default_runtime</exec_depend>

  <!-- Required for interface packages -->
  <member_of_group>rosidl_interface_packages</member_of_group>

  <export>
    <build_type>ament_cmake</build_type>
  </export>

</package>